<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.FlightsFilterFragment">

    <!--Top App Bar -->
    <RelativeLayout
        android:id="@+id/flightsFilterNavBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="10dp">

        <ImageButton
            android:id="@+id/filter_back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/back_button_app_bar"
            android:backgroundTint="@color/screen"
            android:src="@drawable/ic_chevron"/>

        <TextView
            android:id="@+id/transport_booking_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/flights_filter_title"
            android:textSize="17sp"
            android:fontFamily="@font/poppins_bold"
            android:textAppearance="@style/title" />
    </RelativeLayout>

    <!--Filter content field -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/flightsFilterNavBar">

        <RelativeLayout
            android:id="@+id/filter_content_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp">

            <!--Departure field -->
            <RelativeLayout
                android:id="@+id/filter_departure_field"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true">

                <!--Departure text -->
                <TextView
                    android:id="@+id/filter_departure_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/departure_text"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/poppins_bold"
                    android:lineSpacingExtra="-1sp"
                    android:layout_marginStart="20dp"
                    android:gravity="top" />

                <!--Departure options buttons -->
                <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_below="@id/filter_departure_text">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <Button
                            android:id="@+id/filter_departure_button_all"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/all"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:fontFamily="@font/poppins_medium"
                            android:background="@drawable/active_filter_time_button" />

                        <Button
                            android:id="@+id/filter_departure_button_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/_12am_06am"
                            android:textSize="12sp"
                            android:textColor="@color/green_500"
                            android:gravity="center"
                            android:fontFamily="@font/poppins_medium"
                            android:background="@drawable/normal_filter_time_button" />

                        <Button
                            android:id="@+id/filter_departure_button_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/_6am_12pm"
                            android:textSize="12sp"
                            android:textColor="@color/green_500"
                            android:gravity="center"
                            android:fontFamily="@font/poppins_medium"
                            android:background="@drawable/normal_filter_time_button" />

                        <Button
                            android:id="@+id/filter_departure_button_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/_12pm_6pm"
                            android:textSize="12sp"
                            android:textColor="@color/green_500"
                            android:gravity="center"
                            android:fontFamily="@font/poppins_medium"
                            android:background="@drawable/normal_filter_time_button" />

                        <Button
                            android:id="@+id/filter_departure_button_4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/_6pm_12am"
                            android:textSize="12sp"
                            android:textColor="@color/green_500"
                            android:gravity="center"
                            android:fontFamily="@font/poppins_medium"
                            android:background="@drawable/normal_filter_time_button" />

                    </LinearLayout>
                </HorizontalScrollView>

            </RelativeLayout>

            <!--Arrival field -->
            <RelativeLayout
                android:id="@+id/filter_arrival_field"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/filter_departure_field"
                android:layout_marginTop="20dp"
                android:layout_centerHorizontal="true">

                <!--Arrival text -->
                <TextView
                    android:id="@+id/filter_arrival_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/arrival_text"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/poppins_bold"
                    android:lineSpacingExtra="-1sp"
                    android:layout_marginStart="20dp"
                    android:gravity="top" />

                <!--Arrival options buttons -->
                <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_below="@id/filter_arrival_text">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/filter_arrival_button_all"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/all"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:fontFamily="@font/poppins_medium"
                            android:background="@drawable/active_filter_time_button" />

                        <Button
                            android:id="@+id/filter_arrival_button_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/_12am_06am"
                            android:textSize="12sp"
                            android:textColor="@color/green_500"
                            android:gravity="center"
                            android:fontFamily="@font/poppins_medium"
                            android:background="@drawable/normal_filter_time_button" />

                        <Button
                            android:id="@+id/filter_arrival_button_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/_6am_12pm"
                            android:textSize="12sp"
                            android:textColor="@color/green_500"
                            android:gravity="center"
                            android:fontFamily="@font/poppins_medium"
                            android:background="@drawable/normal_filter_time_button" />

                        <Button
                            android:id="@+id/filter_arrival_button_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/_12pm_6pm"
                            android:textSize="12sp"
                            android:textColor="@color/green_500"
                            android:gravity="center"
                            android:fontFamily="@font/poppins_medium"
                            android:background="@drawable/normal_filter_time_button" />

                        <Button
                            android:id="@+id/filter_arrival_button_4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/_6pm_12am"
                            android:textSize="12sp"
                            android:textColor="@color/green_500"
                            android:gravity="center"
                            android:fontFamily="@font/poppins_medium"
                            android:background="@drawable/normal_filter_time_button" />

                    </LinearLayout>
                </HorizontalScrollView>

            </RelativeLayout>

            <!--Price field -->
            <RelativeLayout
                android:id="@+id/filter_price_field"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_below="@+id/filter_arrival_field">

                <!--Price text -->
                <TextView
                    android:id="@+id/filter_price_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/price_text"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/poppins_bold"
                    android:lineSpacingExtra="-1sp"
                    android:layout_marginStart="20dp"
                    android:gravity="top" />

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/filter_price_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/filter_price_text"
                    android:layout_marginTop="10dp"
                    android:valueFrom="0"
                    android:valueTo="400"
                    app:tickColor="@color/green_500"
                    app:values="@array/filter_price_slider_values"
                    android:theme="@style/MyMaterialTheme"/>

                <!--Price from-to field -->
                <RelativeLayout
                    android:id="@+id/filter_price_from_to_field"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_below="@+id/filter_price_slider"
                    android:layout_marginTop="15dp">

                    <!--Price From field -->
                    <RelativeLayout
                        android:id="@+id/filter_price_from_field"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/filter_price_field">

                        <TextView
                            android:id="@+id/filter_price_from_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/from"
                            android:textSize="10sp"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="@font/poppins_medium"
                            android:lineSpacingExtra="1sp"
                            android:translationY="-0.5sp"
                            android:gravity="center_horizontal|top"
                            android:layout_marginStart="15dp"/>

                        <RelativeLayout
                            android:id="@+id/price_from_input_field"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/filter_price_from_text">
                            <TextView
                                android:id="@+id/price_from_dollar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/dollar_sign"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:fontFamily="@font/poppins_medium"
                                android:gravity="bottom|end"/>
                            <EditText
                                android:id="@+id/filter_price_from_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_toEndOf="@+id/price_from_dollar"
                                android:inputType="number"
                                android:text="@string/fifty_decimal"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:fontFamily="@font/poppins_medium"
                                android:lineSpacingExtra="-2sp" />
                        </RelativeLayout>

                    </RelativeLayout>

                    <!--Price To field -->
                    <RelativeLayout
                        android:id="@+id/filter_price_to_field"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/filter_price_from_field"
                        android:layout_marginStart="20dp"
                        android:background="@drawable/filter_price_field">

                        <TextView
                            android:id="@+id/filter_price_to_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/to_text"
                            android:textSize="10sp"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="@font/poppins_medium"
                            android:lineSpacingExtra="1sp"
                            android:translationY="-0.5sp"
                            android:gravity="center_horizontal|top"
                            android:layout_marginStart="15dp"/>

                        <RelativeLayout
                            android:id="@+id/price_to_input_field"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/filter_price_to_text">
                            <TextView
                                android:id="@+id/price_to_dollar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/dollar_sign"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:fontFamily="@font/poppins_medium"
                                android:gravity="bottom|end"/>
                            <EditText
                                android:id="@+id/filter_price_to_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_toEndOf="@+id/price_to_dollar"
                                android:inputType="number"
                                android:text="@string/_250_decimal"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:fontFamily="@font/poppins_medium"
                                android:lineSpacingExtra="-2sp" />
                        </RelativeLayout>

                    </RelativeLayout>

                </RelativeLayout>


            </RelativeLayout>

            <!--Sort field -->
            <RelativeLayout
                android:id="@+id/filter_sort_field"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/filter_price_field"
                android:layout_marginTop="20dp">

                <TextView
                    android:id="@+id/filter_sort_by_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sort_by"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/poppins_bold"
                    android:lineSpacingExtra="-1sp"
                    android:gravity="top"
                    android:layout_marginStart="20dp"/>

                <RadioGroup
                    android:id="@+id/filter_sort_radio_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/filter_sort_by_text"
                    android:layout_marginTop="15dp"
                    android:layout_marginStart="20dp">

                    <RadioButton
                        android:id="@+id/filter_arrivalTime_radioButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="@string/arrival_time"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="14sp" />
                    <RadioButton
                        android:id="@+id/filter_departureTime_radioButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="@string/departure_time"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="14sp" />
                    <RadioButton
                        android:id="@+id/filter_price_radioButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/price_text"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="14sp" />
                    <RadioButton
                        android:id="@+id/filter_duration_radioButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="@string/duration_text"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="14sp" />
                </RadioGroup>

            </RelativeLayout>

            <!--Reset and Done Buttons field -->
            <LinearLayout
                android:id="@+id/filter_reset_done_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_below="@+id/filter_sort_field"
                android:layout_marginTop="50dp"
                android:background="#F5F5F5">

                <!--Reset button -->
                <Button
                    android:id="@+id/filter_reset_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/reset"
                    android:textColor="@color/peach_300"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_margin="10dp"
                    android:background="@drawable/filter_reset_button" />

                <!--Done button -->
                <Button
                    android:id="@+id/filter_done_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/done"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_margin="10dp"
                    android:background="@drawable/filter_done_button" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="100dp"/>

        </RelativeLayout>

    </androidx.core.widget.NestedScrollView>

</RelativeLayout>