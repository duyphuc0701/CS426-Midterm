<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".BoardingPassActivity">

    <!--Top App Bar -->
    <RelativeLayout
        android:id="@+id/boardingPassAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <ImageButton
            android:id="@+id/boarding_back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/back_button_app_bar"
            android:backgroundTint="@color/screen"
            android:src="@drawable/ic_chevron"/>

        <TextView
            android:id="@+id/boarding_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/boarding_pass"
            android:textSize="17sp"
            android:fontFamily="@font/poppins_bold"
            android:textAppearance="@style/title" />

        <ImageButton
            android:id="@+id/boarding_home_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="5dp"
            android:contentDescription="@string/back_button_app_bar"
            android:backgroundTint="@color/screen"
            android:src="@drawable/ic_home"/>
    </RelativeLayout>

    <!--Content field -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/boardingPassAppBar">
        <!--Content field -->
        <RelativeLayout
            android:id="@+id/boarding_content_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:background="@color/white">

            <!--Illustration field -->
            <RelativeLayout
                android:id="@+id/boarding_illustration_field"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true">

                <!--Boarding plane image -->
                <ImageView
                    android:id="@+id/boarding_plane_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:src="@drawable/boarding_pass_plane"
                    android:contentDescription="@string/boarding_pass_plane"/>
                <!--Airways text -->
                <TextView
                    android:id="@+id/airways_flight_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/boarding_plane_image"
                    android:layout_marginTop="10dp"
                    android:text="@string/british_air_nl_41"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/poppins_medium"
                    android:lineSpacingExtra="-2sp"
                    android:gravity="top" />

            </RelativeLayout>

            <!--Divider -->
            <ImageView
                android:id="@+id/boarding_divider_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/boarding_illustration_field"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="15dp"
                android:src="@drawable/ticket_divider"
                android:contentDescription="@string/ticket_divider"/>

            <!--Boarding info field -->
            <RelativeLayout
                android:id="@+id/boarding_info_field"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/boarding_divider_1"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="15dp">

                <!--Ticket locations field -->
                <RelativeLayout
                    android:id="@+id/boarding_locations_field"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true">

                    <!--From field -->
                    <RelativeLayout
                        android:id="@+id/boarding_from_field"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/boarding_from_location_short"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/new_york_shorthand"
                            android:textSize="10sp"
                            android:textColor="@color/green_700"
                            android:fontFamily="@font/poppins_medium"
                            android:lineSpacingExtra="1sp"
                            android:translationY="-0.5sp"
                            android:gravity="top" />

                        <TextView
                            android:id="@+id/boarding_from_location_full"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/boarding_from_location_short"
                            android:text="@string/new_york_full"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="-2sp"
                            android:gravity="top" />

                    </RelativeLayout>

                    <!--Loading image -->
                    <View
                        android:id="@+id/boarding_loading_icon"
                        android:layout_width="130dp"
                        android:layout_height="24dp"
                        android:layout_toEndOf="@id/boarding_from_field"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="20dp"
                        android:background="@drawable/ic_loading"/>

                    <!--To field -->
                    <RelativeLayout
                        android:id="@+id/boarding_to_field"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_toEndOf="@+id/boarding_loading_icon">

                        <TextView
                            android:id="@+id/boarding_to_location_short"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/london_shorthand"
                            android:textSize="10sp"
                            android:textColor="@color/green_700"
                            android:fontFamily="@font/poppins_medium"
                            android:lineSpacingExtra="1sp"
                            android:translationY="-0.5sp"
                            android:gravity="top" />

                        <TextView
                            android:id="@+id/boarding_to_location_full"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/boarding_to_location_short"
                            android:text="@string/london_full"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="-2sp"
                            android:gravity="top" />

                    </RelativeLayout>
                </RelativeLayout>

                <!--Flight info field-->
                <RelativeLayout
                    android:id="@+id/boarding_datetime_field"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/boarding_locations_field"
                    android:layout_marginTop="20dp">

                    <!--Date field-->
                    <RelativeLayout
                        android:id="@+id/boarding_date_field"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/boarding_date_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/date_text"
                            android:textSize="10sp"
                            android:textColor="@color/green_700"
                            android:lineSpacingExtra="1sp"
                            android:translationY="-0.5sp"
                            android:gravity="top" />

                        <TextView
                            android:id="@+id/boarding_date_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/boarding_date_text"
                            android:text="@string/june_02"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="-2sp"
                            android:gravity="top" />
                    </RelativeLayout>

                    <!--Time field-->
                    <RelativeLayout
                        android:id="@+id/boarding_time_field"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/boarding_date_field"
                        android:layout_marginStart="40dp">

                        <TextView
                            android:id="@+id/boarding_time_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/departure_text"
                            android:textSize="10sp"
                            android:textColor="@color/green_700"
                            android:lineSpacingExtra="1sp"
                            android:translationY="-0.5sp"
                            android:gravity="top" />

                        <TextView
                            android:id="@+id/boarding_time_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/boarding_time_text"
                            android:text="@string/nine_am"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="-2sp"
                            android:gravity="top" />
                    </RelativeLayout>

                </RelativeLayout>

            </RelativeLayout>

            <!--Divider -->
            <ImageView
                android:id="@+id/boarding_divider_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/boarding_info_field"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="15dp"
                android:src="@drawable/ticket_divider"
                android:contentDescription="@string/ticket_divider"/>

            <!--Passenger info field -->
            <RelativeLayout
                android:id="@+id/passenger_info_field"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/boarding_divider_2"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="15dp">

                <!--Passenger Number field-->
                <RelativeLayout
                    android:id="@+id/passenger_number_field"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/passenger_number_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/passenger"
                        android:textSize="10sp"
                        android:textColor="@color/green_700"
                        android:lineSpacingExtra="1sp"
                        android:translationY="-0.5sp"
                        android:gravity="top" />

                    <TextView
                        android:id="@+id/passenger_number_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/passenger_number_text"
                        android:text="@string/one_adult"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="-2sp"
                        android:gravity="top" />
                </RelativeLayout>

                <!--Class field-->
                <RelativeLayout
                    android:id="@+id/passenger_class_field"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/passenger_number_field"
                    android:layout_marginStart="40dp">

                    <TextView
                        android:id="@+id/passenger_class_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/class_text"
                        android:textSize="10sp"
                        android:textColor="@color/green_700"
                        android:lineSpacingExtra="1sp"
                        android:translationY="-0.5sp"
                        android:gravity="top" />

                    <TextView
                        android:id="@+id/passenger_class_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/passenger_class_text"
                        android:text="@string/business"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="-2sp"
                        android:gravity="top" />
                </RelativeLayout>

                <!--Ticket code field-->
                <RelativeLayout
                    android:id="@+id/ticket_code_field"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/passenger_class_field"
                    android:layout_marginStart="40dp">

                    <TextView
                        android:id="@+id/ticket_code_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ticket"
                        android:textSize="10sp"
                        android:textColor="@color/green_700"
                        android:lineSpacingExtra="1sp"
                        android:translationY="-0.5sp"
                        android:gravity="top" />

                    <TextView
                        android:id="@+id/ticket_code_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/ticket_code_text"
                        android:text="@string/nl_82_1"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="-2sp"
                        android:gravity="top" />
                </RelativeLayout>

                <!--Seat field-->
                <RelativeLayout
                    android:id="@+id/passenger_seat_field"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/passenger_number_field">

                    <TextView
                        android:id="@+id/passenger_seat_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/seat"
                        android:textSize="10sp"
                        android:textColor="@color/green_700"
                        android:lineSpacingExtra="1sp"
                        android:translationY="-0.5sp"
                        android:gravity="top" />

                    <TextView
                        android:id="@+id/passenger_seat_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/passenger_seat_text"
                        android:text="@string/two_a"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="-2sp"
                        android:gravity="top" />
                </RelativeLayout>

            </RelativeLayout>

            <!--Barcode -->
            <ImageView
                android:id="@+id/boarding_barcode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/passenger_info_field"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="15dp"
                android:src="@drawable/boarding_barcode"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_below="@+id/boarding_barcode"/>

        </RelativeLayout>
    </ScrollView>

    <!--Download ticket button -->
    <Button
        android:id="@+id/boarding_download_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="30dp"
        android:layout_centerHorizontal="true"
        android:text="@string/download_ticket"
        android:textColor="@color/white"
        android:fontFamily="@font/poppins_bold"
        android:textAllCaps="false"
        android:gravity="center"
        android:background="@drawable/ticket_search_button"/>

</RelativeLayout>