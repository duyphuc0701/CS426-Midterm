<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/screen"
    android:orientation="vertical"
    tools:context=".fragments.AccountFragment">

    <TextView
        android:id="@+id/account_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:layout_centerHorizontal="true"
        android:gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:text="@string/account" />

    <ImageView
        android:id="@+id/avatar_imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/account_title"
        android:layout_marginTop="20dp"
        android:layout_centerHorizontal="true"
        android:src="@drawable/avatar_image"
        android:contentDescription="@string/avatar"/>

    <TextView
        android:id="@+id/account_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/avatar_imageView"
        android:layout_marginTop="5dp"
        android:layout_centerHorizontal="true"
        android:text="@string/victoria_yo"
        android:textSize="15sp"
        android:textColor="@color/text_primary"
        android:fontFamily="@font/poppins_bold"
        android:lineSpacingExtra="0sp"
        android:gravity="center_horizontal|bottom" />

    <LinearLayout
        android:id="@+id/account_options"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/account_name"
        android:layout_marginTop="20dp"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/personal_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/personal_information"
            android:contentDescription="@string/personal_info"
            android:background="@android:color/transparent"/>

        <ImageButton
            android:id="@+id/payment_and_cards"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:src="@drawable/payment_and_cards"
            android:contentDescription="@string/payment_and_cards"
            android:background="@android:color/transparent"/>

        <ImageButton
            android:id="@+id/saved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:src="@drawable/saved"
            android:contentDescription="@string/saved"
            android:background="@android:color/transparent"/>

        <ImageButton
            android:id="@+id/booking_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:src="@drawable/booking_history"
            android:contentDescription="@string/booking_history"
            android:background="@android:color/transparent"/>

        <ImageButton
            android:id="@+id/settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:src="@drawable/settings"
            android:contentDescription="@string/settings"
            android:background="@android:color/transparent"/>

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/end_session_button_field"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="10dp"
        android:background="@drawable/end_session_button"
        android:clickable="true"
        android:focusable="true">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">

            <ImageView
                android:id="@+id/end_session_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:src="@drawable/end_session_icon"
                android:contentDescription="@string/end_session_icon"/>

            <TextView
                android:id="@+id/end_session_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/end_session_icon"
                android:layout_marginStart="10dp"
                android:text="@string/end_session"
                android:textSize="17sp"
                android:textColor="@color/alerts_error"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center_horizontal" />

        </RelativeLayout>

    </RelativeLayout>



</RelativeLayout>